# Intestazioni per il servizio che pubblica il sito (Cloudflare Pages o Netlify).

# Protezioni di base su tutte le pagine.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'

# Programmi e caratteri hanno l'impronta nel nome: non cambiano mai.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Video e poster: arriveranno nuove versioni con lo stesso nome (scene 1 e 6
# del racconto), quindi un giorno di copia e poi si ricontrolla.
/video/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/marchio/*
  Cache-Control: public, max-age=604800
